{
  "name": "@agent-os/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "once": "RUNNER_ONCE=1 tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/custom-tools.test.ts",
    "test:budget": "tsx src/budget.test.ts",
    "test:cantfail": "tsx src/cantfail.test.ts",
    "test:cap-breach-flow": "tsx src/cap-breach-flow.test.ts",
    "test:execute-flow": "tsx src/execute-flow.test.ts",
    "test:predispatch": "tsx src/predispatch.test.ts",
    "test:run-state": "tsx src/run-state.test.ts"
  },
  "dependencies": {
    "@agent-os/core": "workspace:*",
    "@agent-os/db": "workspace:*",
    "@agent-os/shared": "workspace:*",
    "@agent-os/tool-browser": "workspace:*",
    "@agent-os/tool-rls-test": "workspace:*",
    "@agent-os/vault": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.150"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
