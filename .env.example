# --- Supabase (control-plane) ---
# Leave these unset to run the UI on built-in demo data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (packages/db: migrations + seed; apps/api + apps/scheduler) ---
# Point at a Postgres 16 + pgvector instance (e.g. Supabase or local docker).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# --- API server (apps/api) ---
PORT=8787
# Base URL the runner should call back to; embedded in the /next Bundle.
PUBLIC_URL=http://localhost:8787

# --- Scheduler (apps/scheduler) ---
SCHEDULER_INTERVAL_MS=30000
# Set to 1 to evaluate once and exit (useful in cron/CI).
SCHEDULER_ONCE=

# --- Runner (apps/runner) ---
# Pull-based worker. Polls the API for the agents it owns and executes runs.
API_URL=http://localhost:8787
RUNNER_API_KEY=
# Comma-separated agent UUIDs this runner owns.
RUNNER_AGENT_IDS=
RUNNER_ID=
POLL_INTERVAL_MS=60000
# Optional: with a key the runner uses the live Claude Agent SDK; without it,
# it runs in DRY-RUN (simulated) mode so the loop is exercisable.
ANTHROPIC_API_KEY=
