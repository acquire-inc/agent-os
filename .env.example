# --- Supabase (control-plane) ---
# Leave these unset to run the UI on built-in demo data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Database (packages/db: migrations + seed) ---
# Point at a Postgres 16 + pgvector instance (e.g. Supabase or local docker).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
