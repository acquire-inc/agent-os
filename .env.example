# ────────────────────────────────────────────────────────────────────
#  AgentOS — environment template
# ────────────────────────────────────────────────────────────────────
#
# RECOMMENDED PATTERN: ONE OPENROUTER KEY FOR EVERYTHING.
#
# Per CLAUDE.md doctrine (Main §1.2/§6): the canonical gateway is OpenRouter.
# Both the runner (Claude Agent SDK) and the Architect (OpenAI-style chat
# completions) route through OpenRouter. T-cheap and T-reason use
# nousresearch/hermes-*, T-work and T-critical use anthropic/claude-*.
# All slugs resolve through OpenRouter — no need to maintain separate
# Anthropic + Hermes accounts.
#
# Minimum keys to launch:
#   1.  OPENROUTER_API_KEY  — get from https://openrouter.ai/keys
#   2.  ANTHROPIC_API_KEY   — same value as OPENROUTER_API_KEY (gateway mode)
#   3.  ANTHROPIC_BASE_URL  — https://openrouter.ai/api
#   4.  DATABASE_URL        — Supabase (or self-hosted Postgres 16 + pgvector)
#   5.  AOS_VAULT_KEY       — generated locally (see command below)
#
# Read docs/connect-and-launch.md for the step-by-step setup.

# ── Model gateway (OpenRouter — the one place tokens are spent) ──────
# Same value for both. The runner reads ANTHROPIC_*; the Architect reads
# OPENROUTER_API_KEY. Setting both to the same OpenRouter key consolidates
# billing and audit.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://openrouter.ai/api
# Optional: override the Architect's default model (Hermes 405B).
ARCHITECT_MODEL=nousresearch/hermes-4-405b

# ── Supabase (database + auth + RLS) ─────────────────────────────────
# Create a project at https://supabase.com — Postgres 16 + pgvector are on
# by default. Settings → API → copy the URL + anon key + service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server-only (never exposed to the browser).
SUPABASE_SERVICE_ROLE_KEY=
# Direct DB connection (Settings → Database → Connection string → "URI").
# Used by migrations, seed scripts, and the API.
# DO NOT use this DATABASE_URL outside localhost. Replace with a managed Postgres URI in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentos

# ── API server (apps/api) ────────────────────────────────────────────
PORT=8787
# Base URL the RUNNER calls back to. In production this is your API's
# public hostname (https://api.yourdomain.com).
PUBLIC_URL=http://localhost:8787
# Vault key — base64-encoded 32 random bytes. Encrypts MCP connector creds
# so the runner can decrypt them at bundle-build time. Without it the
# bundle ships placeholder creds and connectors won't auth.
# Generate:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
AOS_VAULT_KEY=

# ── Inngest (durable scheduler) ──────────────────────────────────────
# Create an app at https://app.inngest.com. Without these, the in-process
# scheduler stays running, but you lose retries/observability.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# ── Approval mirrors (optional) ──────────────────────────────────────
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Scheduler (apps/scheduler) ───────────────────────────────────────
SCHEDULER_INTERVAL_MS=30000
# Set to 1 to evaluate once and exit (useful in cron/CI).
SCHEDULER_ONCE=

# ── Runner (apps/runner) ─────────────────────────────────────────────
# Pull-based worker. Polls the API for the agents it owns and executes runs.
API_URL=http://localhost:8787
RUNNER_API_KEY=
# Comma-separated agent UUIDs this runner owns. Generated by
# `pnpm tenant:new` when you provision a tenant.
RUNNER_AGENT_IDS=
RUNNER_ID=
POLL_INTERVAL_MS=60000
# RUNNER_DRY_RUN=1 forces simulation even when ANTHROPIC_API_KEY is set
# (useful for staging or load tests).
RUNNER_DRY_RUN=

# ── Smoke + admin tools ──────────────────────────────────────────────
# Used by `pnpm smoke` post-deploy test.
AOS_BASE_URL=
AOS_ADMIN_KEY=

# ── Connector OAuth (optional — Nango) ───────────────────────────────
# When connecting Slack, HubSpot, Stripe etc. through Nango instead of
# direct vault'd API keys. Off by default — see docs/main-acqu-agent-doctrine.md §2.4
NANGO_SECRET_KEY=
NANGO_PUBLIC_KEY=
NANGO_HOST=https://api.nango.dev

# ── Lead pipeline (P3 Discovery + P4 Enrichment+Scoring) ────────────
# Each is OPTIONAL — the corresponding tool returns { ok: false, error }
# when its key is missing, and the agent logs + skips. Discovery still
# works on whichever sources have keys; enrichment falls back to the
# fields it can fill.
APIFY_TOKEN=
APOLLO_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=             # optional — Jina Reader allows keyless low-volume use
FIRECRAWL_API_KEY=
NEVERBOUNCE_API_KEY=      # if absent, email_verify returns status=unknown
NUMVERIFY_API_KEY=        # if absent, phone_validate returns type=unknown

# ── Control plane build (Vite) ───────────────────────────────────────
# API base the SPA calls in production (https://api.yourdomain.com).
VITE_API_URL=

# ── V2 loop kill switches (docs/feature-flags.md) ────────────────────
# Set to 1 to disable a loop platform-wide. All default OFF (loops on).
AOS_FEATURE_MEMORY_LOOP_DISABLED=
AOS_FEATURE_REFLEXION_DISABLED=
AOS_FEATURE_SELF_IMPROVEMENT_DISABLED=
AOS_FEATURE_CRITIC_QUORUM_DISABLED=
AOS_FEATURE_LEASE_DISABLED=

# ── Platform-owner + connector OAuth refreshers ──────────────────────
# Tenant slug treated as platform owner (models/catalog write access).
PLATFORM_OWNER_TENANT_SLUG=acqu
# Close CRM OAuth app credentials — used by the vault rotation refresher.
CLOSE_OAUTH_CLIENT_ID=
CLOSE_OAUTH_CLIENT_SECRET=

# ── Live isolation suite (hard gate #2 — pnpm verify:isolation-live) ─
# Postgres URI the RLS attack vectors run against (usually same DB) and
# two REAL auth.users ids in different tenants.
RLS_TEST_DATABASE_URL=
RLS_TEST_USER_A=
RLS_TEST_USER_B=
