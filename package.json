{
  "name": "agent-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter control-plane dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @agent-os/db generate",
    "db:migrate": "pnpm --filter @agent-os/db migrate",
    "db:seed": "pnpm --filter @agent-os/db seed"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
