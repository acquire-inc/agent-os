{
  "name": "agent-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter control-plane dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @agent-os/db generate",
    "db:migrate": "pnpm --filter @agent-os/db migrate",
    "db:seed": "pnpm --filter @agent-os/db seed",
    "seed:acqu-vitals": "pnpm --filter @agent-os/seed run acqu-vitals",
    "seed:phase-1": "pnpm --filter @agent-os/seed run phase-1",
    "seed:phase-2": "pnpm --filter @agent-os/seed run phase-2",
    "seed:phase-3": "pnpm --filter @agent-os/seed run phase-3",
    "verify": "bash scripts/test-all.sh",
    "seed:tool-browser": "pnpm --filter @agent-os/seed run tool-browser",
    "seed:phase-4": "pnpm --filter @agent-os/seed run phase-4",
    "seed:phase-9": "pnpm --filter @agent-os/seed run phase-9",
    "verify:isolation-live": "pnpm --filter @agent-os/verify run isolation-live",
    "launch:check": "pnpm --filter @agent-os/launch-readiness run check",
    "smoke": "pnpm --filter @agent-os/smoke run run"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
